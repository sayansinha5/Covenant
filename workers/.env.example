# Settings for the demo workers (lipi, tally, quickwordz).
WORKER_HOST=127.0.0.1
LIPI_PORT=9101
TALLY_PORT=9102
QUICKWORDZ_PORT=9103
# URLs each Agent Card advertises. These must be on ALLOWED_AGENT_HOSTS in backend/.env.
LIPI_PUBLIC_URL=http://127.0.0.1:9101
TALLY_PUBLIC_URL=http://127.0.0.1:9102
QUICKWORDZ_PUBLIC_URL=http://127.0.0.1:9103
# Shared bearer tokens Covenant uses to call each worker (set when registering; dev defaults)
LIPI_AUTH_TOKEN=dev-lipi-token-7c21b9
TALLY_AUTH_TOKEN=dev-tally-token-4e88d0
QUICKWORDZ_AUTH_TOKEN=dev-quickwordz-token-a19f3c
# Behaviour switches for the demo
TALLY_FAULT_RATE=0.2
QUICKWORDZ_ADVERSARIAL=true
# AI provider (same options as backend/.env)
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_FAST=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=covenant-workers
