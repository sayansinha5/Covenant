# Local MySQL account names. The API and runner read this file and backend/.env.
# Development defaults only; change them for anything shared.

DB_NAME=covenant
DB_TEST_NAME=covenant_test
DB_USER=covenant_app
DB_PASSWORD=covenant_dev_password
DB_MIGRATOR_USER=covenant_migrator
DB_MIGRATOR_PASSWORD=covenant_dev_migrator_password

# Password you set for the local MySQL root account. The app does not read this.
MYSQL_ROOT_PASSWORD=covenant_dev_root_password
