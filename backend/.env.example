# Backend settings for the API and the job runner.
# The process environment wins, then this file, then the repo-root .env.
# Local-only values have working development defaults. Values that need real accounts
# (PayPal, AI provider, LangSmith) are intentionally empty and reported as "not configured".
# Keep a comment for an empty value on its own line.

# ── App ─────────────────────────────────────────────
APP_ENV=development                 # development | test (anything else enforces non-default secrets)
APP_NAME=Covenant
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
RUNNER_EMBEDDED=false               # true = run the job loop inside the API process
RUNNER_POLL_SECONDS=1               # idle wait between polls of the outbox
RUNNER_BATCH_SIZE=5                 # jobs claimed per poll
RUNNER_LEASE_SECONDS=600            # a job held longer than this is reclaimed by another runner

# ── Database (MySQL 8) ─────────────────────────────
# DB_NAME, DB_TEST_NAME, DB_USER, DB_PASSWORD, DB_MIGRATOR_USER and DB_MIGRATOR_PASSWORD
# come from the repo-root .env. Set them here instead if you prefer one file.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_POOL_SIZE=10

# ── Auth ───────────────────────────────────────────
JWT_SECRET=dev-only-covenant-jwt-secret-change-me-0f8e3a71c94b2d56e1a7
JWT_ISSUER=covenant-local
JWT_AUDIENCE=covenant-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SEED_ADMIN_EMAIL=admin@covenant.local
SEED_ADMIN_PASSWORD=ChangeMe-Admin-2026   # local seed only

# ── PayPal (sandbox) ───────────────────────────────
PAYPAL_ENV=sandbox                  # sandbox only in this PoC
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Client ID and secret from your sandbox REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the webhook you register for your tunnel URL
PAYPAL_WEBHOOK_ID=
PAYPAL_FUNDING_MODE=vault           # vault | approve_each (fallback if Vault is not enabled)
PAYPAL_PAYOUTS_ENABLED=true         # false = record payouts as pending, skip the API call
PAYPAL_RETURN_BASE_URL=http://localhost:8000
PAYPAL_HTTP_TIMEOUT_SECONDS=15

# ── Money and policy defaults ──────────────────────
CURRENCY=USD
PLATFORM_FEE_RATE=0.05
DEFAULT_MONTHLY_BUDGET=300.00
DEFAULT_PER_TASK_CAP=60.00
DEFAULT_APPROVAL_THRESHOLD=40.00
APPROVAL_EXPIRY_HOURS=24
APPEAL_WINDOW_MINUTES=60
AGENT_ACCEPT_TIMEOUT_MINUTES=10
AGENT_DEFAULT_DEADLINE_MINUTES=30
HUMAN_ACCEPT_TIMEOUT_HOURS=24
HUMAN_DEFAULT_DEADLINE_HOURS=72
AUTH_HONOR_PERIOD_DAYS=3

# ── AI provider ────────────────────────────────────
# AI_PROVIDER options (LangChain init_chat_model provider names + the package to install):
#   openai          -> langchain-openai
#   anthropic       -> langchain-anthropic
#   google_genai    -> langchain-google-genai   (Gemini API)
#   mistralai       -> langchain-mistralai
#   groq            -> langchain-groq
#   azure_openai    -> langchain-openai        (also set AI_BASE_URL and AI_API_VERSION)
#   ollama          -> langchain-ollama        (local models; no key, set AI_BASE_URL=http://localhost:11434)
AI_PROVIDER=
AI_API_KEY=
# Optional: OpenAI-compatible gateways, Azure, Ollama
AI_BASE_URL=
# Azure only
AI_API_VERSION=
# Model IDs: use exact model names from your provider's current docs.
#   AI_MODEL      default model, used when a tier below is empty
#   AI_FAST       cheap and quick: manipulation classifier, short summaries
#   AI_MEDIUM     buyer agent, spec writer
#   AI_SUPER      arbiter judge (strongest general model)
#   AI_REASONING  appeal memo, second opinion fallback (reasoning model)
AI_MODEL=
AI_FAST=
AI_MEDIUM=
AI_SUPER=
AI_REASONING=
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# Optional second-opinion model from a different provider (recommended);
# SECOND_OPINION_PROVIDER takes the same options as AI_PROVIDER.
SECOND_OPINION_PROVIDER=
SECOND_OPINION_MODEL=
SECOND_OPINION_API_KEY=
SECOND_OPINION_BASE_URL=

# ── Arbiter tuning ─────────────────────────────────
ARBITER_ITEM_PASS_SCORE=7.0
ARBITER_PASS_BAND_MIN=0.90
ARBITER_PARTIAL_BAND_MIN=0.50
ARBITER_BORDER_MARGIN=0.05
ARBITER_LOW_CONFIDENCE=0.60
ARBITER_MANIPULATION_THRESHOLD=0.80
ARBITER_BATCH_SIZE=10
MAX_DELIVERY_BYTES=1048576

# ── LangSmith (optional) ───────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=covenant-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── Workers and uploads ────────────────────────────
ALLOWED_AGENT_HOSTS=127.0.0.1,localhost
AGENT_HTTP_TIMEOUT_SECONDS=5
STORAGE_DIR=storage
MAX_UPLOAD_MB=5

# ── Rate limits ────────────────────────────────────
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_MONEY=30/minute
RATE_LIMIT_ASSISTANT=20/minute

# ── Catalog, search, and the agent fleet ───────────
# Channel3 product graph (https://trychannel3.com/developers). The Catalog page searches it
# and turns the picks into an assistant brief. Leave the key empty to keep the page, without live results.
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com
# Astropods fleet (https://astropods.com/). The token is an access token from `ast login`
# (about an hour) or a machine-app token. The account is the name in the Astropods URL.
# Both are required before Fleet calls the API.
ASTROPODS_API_TOKEN=
ASTROPODS_ACCOUNT=
ASTROPODS_BASE_URL=https://astropods.com/api/v1
# Elasticsearch is optional. Point this at a local cluster (http://127.0.0.1:9200) or leave
# it empty. For Elastic Cloud, set ELASTIC_CLOUD_ID and ELASTIC_API_KEY instead.
# Search keeps working from the database when the cluster is down.
ELASTICSEARCH_URL=
ELASTIC_API_KEY=
ELASTIC_CLOUD_ID=
